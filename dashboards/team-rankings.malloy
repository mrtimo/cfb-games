##! experimental { givens }

// =====================================================================
//  TEAM RANKINGS
//
//  One row per team: record, points scored and allowed, and drive
//  efficiency on both sides of the ball. The component
//  (team-rankings.tsx) draws it as one wide table that re-ranks on a
//  click of any column header.
//
//  ONE drive join per team-game, holding the drives the team was on the
//  field for on either side of the ball; offense and defense are filters
//  on it. Two separate joins (offense drives, defense drives) multiplied
//  out to ~12 x 12 rows per team-game and built the drive model twice —
//  4.4 s in the browser. One join is ~24 rows and one pass.
//
//  The garbage-time checkbox thins the DRIVE columns only. It is applied
//  on the joined drive source rather than in the query's where:, which
//  would knock whole games out of the record.
// =====================================================================

import "../index.malloy"
import "../givens.malloy"

#(doc) Drives with garbage time left out when the checkbox is on.
source: ranking_drives is drives extend {
  where: $EXCLUDE_GARBAGE = false or not is_garbage_possession
}

#(doc) Team-games with every (optionally garbage-free) drive the team was on the field for, on either side of the ball.
source: ranking_team_games is team_games extend {
  join_many: team_drives is ranking_drives
    on game_id = team_drives.GameId and (team = team_drives.Offense or team = team_drives.Defense)

  dimension:
    #(doc) True for a drive this team ran.
    on_offense is team_drives.Offense = team

    #(doc) True for a drive this team defended.
    // Tested directly, never as `not on_offense`: a team-game with no drives
    // (an unplayed game, or one against a division without drive data) still
    // joins one empty row, and `not` of its null counts it as a defensive
    // drive — one phantom drive per such game in every defense column.
    on_defense is team_drives.Defense = team
}

#" Every team ranked on record, scoring and drive efficiency on both sides of the ball. Click a column header to re-rank.
# artifact { title="Team Rankings" }
query: team_rankings is ranking_team_games -> {
  where:
    season_label ~ $SEASON,
    classification ~ $DIVISION,
    conference ~ $CONFERENCE

  group_by:
    team
    conference

  aggregate:
    // ---- record ----
    games_played
    wins
    losses
    win_rate
    points_per_game
    points_allowed_per_game
    avg_scoring_margin

    // ---- offense ----
    offense_drives is team_drives.drive_count { where: on_offense }
    offense_points_per_drive is team_drives.points_per_drive { where: on_offense }
    offense_yards_per_play is team_drives.yards_per_play { where: on_offense }
    offense_eckel_rate is team_drives.eckel_rate { where: on_offense }
    offense_touchdown_rate is team_drives.touchdown_rate { where: on_offense }
    offense_explosive_rate is team_drives.explosive_drive_rate { where: on_offense }
    offense_three_and_out_rate is team_drives.three_and_out_rate { where: on_offense }
    offense_turnover_rate is team_drives.turnover_rate { where: on_offense }
    offense_avg_start is team_drives.avg_start_field_position { where: on_offense }

    // ---- defense ----
    defense_points_per_drive is team_drives.points_per_drive { where: on_defense }
    defense_yards_per_play is team_drives.yards_per_play { where: on_defense }
    defense_eckel_rate is team_drives.eckel_rate { where: on_defense }
    defense_three_and_out_rate is team_drives.three_and_out_rate { where: on_defense }
    defense_takeaway_rate is team_drives.turnover_rate { where: on_defense }

    // ---- overall ----
    net_points_per_drive is
      team_drives.points_per_drive { where: on_offense }
      - team_drives.points_per_drive { where: on_defense }
    current_elo
    strength_of_schedule

  having: games_played > 0
  order_by: net_points_per_drive desc
}
